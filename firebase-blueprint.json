{
  "entities": {
    "Workspace": {
      "title": "Workspace",
      "description": "A collaborative TaskOwl workspace shared across members via email.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "ownerEmail": { "type": "string", "maxLength": 254 },
        "memberEmails": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time", "maxLength": 64 },
        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["id", "name", "ownerId", "ownerEmail", "memberEmails", "createdAt"]
    },
    "WorkspaceMember": {
      "title": "Workspace Member",
      "description": "A collaborator added to a workspace by email who can be assigned tasks.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 254 },
        "name": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "maxLength": 80 },
        "workspaceRole": { "type": "string", "enum": ["owner", "member"] },
        "initials": { "type": "string", "maxLength": 4 },
        "avatar": { "type": "string", "maxLength": 500 },
        "uid": { "type": "string", "maxLength": 128 },
        "addedBy": { "type": "string", "maxLength": 128 },
        "addedAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["id", "email", "name", "role", "workspaceRole", "initials", "addedBy", "addedAt"]
    },
    "Task": {
      "title": "Task",
      "description": "A deliverable task managed by TaskOwl within a workspace.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 500 },
        "description": { "type": "string", "maxLength": 5000 },
        "lane": { "type": "string", "enum": ["backlog", "in_progress", "review", "done"] },
        "priority": { "type": "string", "enum": ["low", "medium", "high", "urgent"] },
        "originalPriority": { "type": "string", "enum": ["low", "medium", "high", "urgent"] },
        "deadline": { "type": "string", "format": "date-time", "maxLength": 64 },
        "estimatedHours": { "type": "number" },
        "assignee": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "maxLength": 120 },
            "email": { "type": "string", "maxLength": 254 },
            "role": { "type": "string", "maxLength": 80 },
            "initials": { "type": "string", "maxLength": 4 },
            "avatar": { "type": "string", "maxLength": 500 }
          }
        },
        "tags": { "type": "array", "items": { "type": "string" } },
        "syncedToCalendar": { "type": "boolean" },
        "calendarEventId": { "type": "string", "maxLength": 256 },
        "calendarEventUrl": { "type": "string", "maxLength": 1000 },
        "escalated": { "type": "boolean" },
        "email48hSent": { "type": "boolean" },
        "email24hSent": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time", "maxLength": 64 },
        "completedAt": { "type": "string", "format": "date-time", "maxLength": 64 },
        "createdBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "title", "lane", "priority", "deadline", "estimatedHours", "assignee", "tags", "syncedToCalendar", "escalated", "createdAt"]
    },
    "AutomationPreferences": {
      "title": "Automation Preferences",
      "description": "Workspace preferences for task automations and reminders.",
      "type": "object",
      "properties": {
        "notify24Hours": { "type": "boolean" },
        "notify1Hour": { "type": "boolean" },
        "autoEscalateOverdue": { "type": "boolean" },
        "autoEscalateHoursThreshold": { "type": "number" },
        "morningDigest": { "type": "boolean" },
        "morningDigestTime": { "type": "string", "maxLength": 16 },
        "calendarReminderMinutes": { "type": "number" },
        "emailUpdatesEnabled": { "type": "boolean" },
        "recipientEmail": { "type": "string", "maxLength": 254 },
        "customReminderMessage": { "type": "string", "maxLength": 2000 },
        "audioChimesEnabled": { "type": "boolean" },
        "remindCalendarExternalEvents": { "type": "boolean" }
      }
    },
    "DashboardCustomization": {
      "title": "Dashboard Customization",
      "description": "User preferences for dashboard theme and layout.",
      "type": "object",
      "properties": {
        "themeMode": { "type": "string", "enum": ["dark", "light"] },
        "accentColor": { "type": "string", "maxLength": 20 },
        "accentLabel": { "type": "string", "maxLength": 80 },
        "density": { "type": "string", "enum": ["comfortable", "compact"] },
        "visibleWidgets": { "type": "object" },
        "widgetOrder": { "type": "array", "items": { "type": "string" } },
        "kpiOrder": { "type": "array", "items": { "type": "string" } },
        "kanbanLaneOrder": { "type": "array", "items": { "type": "string" } },
        "tableColumnOrder": { "type": "array", "items": { "type": "string" } }
      }
    },
    "AutomationLog": {
      "title": "Automation Log",
      "description": "A log entry for an executed automation rule.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ruleName": { "type": "string", "maxLength": 200 },
        "taskId": { "type": "string", "maxLength": 128 },
        "taskTitle": { "type": "string", "maxLength": 500 },
        "triggeredAt": { "type": "string", "format": "date-time", "maxLength": 64 },
        "status": { "type": "string", "enum": ["success", "warning", "info"] },
        "details": { "type": "string", "maxLength": 2000 }
      },
      "required": ["id", "ruleName", "triggeredAt", "status", "details"]
    },
    "InAppNotification": {
      "title": "Notification",
      "description": "An in-app notification for workspace members.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 1000 },
        "taskId": { "type": "string", "maxLength": 128 },
        "timestamp": { "type": "string", "format": "date-time", "maxLength": 64 },
        "read": { "type": "boolean" },
        "actionUrl": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "type", "title", "message", "timestamp", "read"]
    }
  },
  "firestore": {
    "/workspaces/{workspaceId}": {
      "schema": "Workspace",
      "description": "Shared collaborative workspaces accessible to owner and invited member emails."
    },
    "/workspaces/{workspaceId}/members/{memberId}": {
      "schema": "WorkspaceMember",
      "description": "Members added to the workspace by email."
    },
    "/workspaces/{workspaceId}/tasks/{taskId}": {
      "schema": "Task",
      "description": "Tasks belonging to a shared workspace."
    },
    "/workspaces/{workspaceId}/preferences/automation": {
      "schema": "AutomationPreferences",
      "description": "Automation settings for a workspace."
    },
    "/workspaces/{workspaceId}/preferences/customization": {
      "schema": "DashboardCustomization",
      "description": "Dashboard layout and theme customization for a workspace."
    },
    "/workspaces/{workspaceId}/logs/{logId}": {
      "schema": "AutomationLog",
      "description": "Automation execution logs for a workspace."
    },
    "/workspaces/{workspaceId}/notifications/{notificationId}": {
      "schema": "InAppNotification",
      "description": "Notifications for a workspace."
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": "Task",
      "description": "Legacy personal task collection preserved for seamless migration."
    },
    "/users/{userId}/preferences/automation": {
      "schema": "AutomationPreferences",
      "description": "Legacy personal automation preferences."
    },
    "/users/{userId}/preferences/customization": {
      "schema": "DashboardCustomization",
      "description": "Legacy personal dashboard customization."
    },
    "/users/{userId}/logs/{logId}": {
      "schema": "AutomationLog",
      "description": "Legacy personal automation logs."
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": "InAppNotification",
      "description": "Legacy personal notifications."
    }
  }
}
