rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Entity Validations ---

    function isValidTask(data) {
      return data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 200
        && data.description is string && data.description.size() <= 2000
        && data.lane in ['backlog', 'in_progress', 'review', 'done']
        && data.priority in ['low', 'medium', 'high', 'urgent']
        && data.deadline is string // Simplified for rules, but client should send ISO
        && data.estimatedHours is number
        && data.assignee.name is string
        && data.assignee.role is string
        && data.assignee.initials is string
        && data.tags is list && data.tags.size() <= 10
        && data.syncedToCalendar is bool
        && data.escalated is bool
        && (data.completedAt == null || data.completedAt is string);
    }

    function isValidAutomationPreferences(data) {
      return data.notify24Hours is bool
        && data.notify1Hour is bool
        && data.autoEscalateOverdue is bool
        && data.autoEscalateHoursThreshold is number
        && data.morningDigest is bool
        && data.morningDigestTime is string
        && data.calendarReminderMinutes is number
        && data.emailUpdatesEnabled is bool
        && data.recipientEmail is string
        && data.audioChimesEnabled is bool
        && (data.remindCalendarExternalEvents == null || data.remindCalendarExternalEvents is bool);
    }

    function isValidDashboardCustomization(data) {
      return data.themeMode in ['dark', 'light']
        && data.accentColor is string && data.accentColor.size() <= 7
        && data.density in ['comfortable', 'compact']
        && data.visibleWidgets is map
        && data.widgetOrder is list
        && data.kpiOrder is list
        && data.tableColumnOrder is list;
    }

    function isValidLog(data) {
      return data.id is string
        && data.ruleName is string
        && data.triggeredAt is string
        && data.status in ['success', 'warning', 'info']
        && data.details is string;
    }

    function isValidNotification(data) {
      return data.id is string
        && data.type is string
        && data.title is string
        && data.message is string
        && data.timestamp is string
        && data.read is bool;
    }

    // --- Match Groups ---

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /tasks/{taskId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(taskId) && isValidTask(incoming())
          && incoming().createdAt is string;
        allow update: if isOwner(userId) && isValidTask(incoming())
          && incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId);
      }

      match /preferences/automation {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidAutomationPreferences(incoming());
      }

      match /preferences/customization {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidDashboardCustomization(incoming());
      }

      match /logs/{logId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(logId) && isValidLog(incoming())
          && incoming().triggeredAt is string;
        allow delete: if isOwner(userId);
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(notificationId) && isValidNotification(incoming());
        allow update: if isOwner(userId) && isValidNotification(incoming());
        allow delete: if isOwner(userId);
      }
    }
  }
}
